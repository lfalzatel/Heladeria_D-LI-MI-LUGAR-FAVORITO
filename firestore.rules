rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Admin check based on trusted list
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lfalzatel@gmail.com' || 
        request.auth.token.email == 'lfalzatel@gmai.com' ||
        request.auth.token.email == 'admin@dli.com'
      );
    }

    // ==========================================
    // VALIDATION BLUEPRINTS
    // ==========================================

    function isValidUser(data) {
      return data.email is string &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'propietario', 'vendedor', 'cliente'];
    }

    function isValidSale(data) {
      return data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod in ['Efectivo', 'Transferencia', 'Tarjeta'] &&
             data.status in ['completed', 'cancelled'] &&
             data.soldBy == request.auth.uid;
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLLECTION RULES
    // ==========================================

    // Users: Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'vendedor'; 
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        // Only admin can change roles
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['role'])) ||
        (!isAdmin() && !incoming().diff(existing()).affectedKeys().hasAny(['role']))
      );
    }

    // Products & Flavors: Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /icecreamFlavors/{flavorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Tables: Live states
    match /tables/{tableId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && isValidId(tableId);
    }

    // Sales: Transaction records
    match /sales/{saleId} {
      allow get: if isSignedIn() && (isOwner(existing().soldBy) || isAdmin());
      allow list: if isSignedIn() && (resource.data.soldBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSale(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Supplies: Inventory
    match /supplies/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /supplyPurchases/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
