rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Admins de D'LI
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lfalzatel@gmail.com' || 
        request.auth.token.email == 'lfalzatel@gmai.com' ||
        request.auth.token.email == 'admin@dli.com'
      );
    }

    function isPropietario() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'propietario';
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'propietario', 'vendedor']
      );
    }

    // ==========================================
    // VALIDATION BLUEPRINTS
    // ==========================================

    // AJUSTADO: Hacemos que el correo (email) sea opcional para permitir creación Express sin email
    function isValidUser(data) {
      return (!('email' in data) || data.email == null || data.email is string) &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'propietario', 'vendedor', 'cliente'];
    }

    // AJUSTADO: Se añade 'credito' (Debe) a los métodos de pago válidos
    function isValidSale(data) {
      return data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod in ['Efectivo', 'Transferencia', 'Tarjeta', 'Mixto', 'credito'] &&
             data.status in ['completed', 'cancelled'] &&
             (data.soldBy == request.auth.uid || data.sellerId == request.auth.uid);
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLLECTION RULES
    // ==========================================

    // Users: Profiles
    match /users/{userId} {
      function changedKeys() {
        return incoming().diff(existing()).affectedKeys();
      }
      // Cada quien ve su perfil; el personal ve los de todos (para notificar y enviar recibos)
      allow get: if isOwner(userId) || isStaff();
      // El personal (también vendedores) necesita la lista de clientes para asignar ventas, fiados y estrellas
      allow list: if isStaff();
      // Nadie puede crearse a sí mismo como personal: los perfiles nuevos son 'cliente'.
      // Solo admin y propietaria crean perfiles con otro rol.
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || isPropietario() ||
        (incoming().role == 'cliente' && incoming().get('loyaltyPoints', 0) == 0 && (isOwner(userId) || isStaff()))
      );
      allow update: if isAdmin()
        || (isPropietario() && existing().role != 'admin' && (!changedKeys().hasAny(['role']) || incoming().role != 'admin'))
        // Cada quien edita su perfil (teléfono, dirección, notificaciones), pero no su rol ni sus estrellas
        || (isOwner(userId) && !changedKeys().hasAny(['role', 'loyaltyPoints']))
        // Vendedores: solo las estrellas de los clientes
        || (isStaff() && existing().get('role', '') == 'cliente' && changedKeys().hasOnly(['loyaltyPoints']));
    }

    // Products & Flavors & Categories: Catalog
    // Carta pública: lectura sin cuenta (catálogo para invitados y QR de mesas)
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff(); // Cambiado de true a seguro en producción
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff(); // Cambiado de true a seguro en producción
    }

    match /icecreamFlavors/{flavorId} {
      allow read: if true;
      allow write: if isStaff(); // Cambiado de true a seguro en producción
    }

    // Tables: Live states
    match /tables/{tableId} {
      allow read: if isStaff(); // Solo personal: contiene las claves de los QR de mesa
      allow write: if isStaff(); // Asegurado para el personal de ventas
    }

    // Pedidos desde la mesa por QR: el cliente solo puede crear con la clave vigente de una mesa activa;
    // el personal los acepta y los pasa al carrito de la mesa
    match /tableRequests/{requestId} {
      function tableDoc() {
        return get(/databases/$(database)/documents/tables/$(incoming().tableId)).data;
      }
      allow create: if isSignedIn()
        && incoming().clienteId == request.auth.uid
        && incoming().status == 'pendiente'
        && incoming().kind in ['pedido', 'llamada']
        && incoming().tableId is string && isValidId(incoming().tableId)
        && exists(/databases/$(database)/documents/tables/$(incoming().tableId))
        && tableDoc().get('active', false) == true
        && tableDoc().get('qrKey', '') == incoming().key
        && incoming().items is list && incoming().items.size() <= 30;
      allow read: if isSignedIn() && (resource.data.clienteId == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    // Sales: Transaction records (Institucionales/Mesa)
    match /sales/{saleId} {
      allow get: if isStaff() || (isSignedIn() && resource.data.get('clienteId', '') == request.auth.uid); // Cliente: solo sus compras
      allow list: if isStaff() || (isSignedIn() && resource.data.get('clienteId', '') == request.auth.uid);
      allow create: if isSignedIn() && isValidSale(incoming());
      allow update: if isAdmin() || isPropietario()
        // Vendedores: registrar abonos a un fiado y ajustar empaques, sin tocar el valor de la venta
        || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['totalAbonado', 'packagingSupplies', 'productionCost', 'profit', 'packagingCost']));
      allow delete: if isAdmin() || isPropietario();
    }

    // NUEVO: Reglas para la colección de Abonos
    match /abonos/{abonoId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.get('clienteId', '') == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if isAdmin() || isPropietario();
    }

    // Carritos: Sincronización de carrito de compras
    match /carts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Pedidos: Checkout Cliente (PWA)
    match /pedidos/{pedidoId} {
      allow read: if isSignedIn() && (resource.data.clienteId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.clienteId == request.auth.uid;
      // El cliente solo puede escribir en el chat de su pedido o cancelarlo mientras está pendiente
      allow update: if isStaff() || (isSignedIn() && resource.data.clienteId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'chatMessages', 'updatedAt'])
        || (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existing().status == 'pendiente' && incoming().status == 'cancelado')
      ));
      allow delete: if isStaff();
    }

    // Supplies: Inventory
    match /supplies/{id} {
      allow read: if isStaff(); // Costos internos
      allow write: if isStaff();
    }

    match /supplyPurchases/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /wasteRecords/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /providers/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Gastos: Finanzas personales y control de gastos
    match /gastos/{gastoId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Ingresos personales del cliente (Mis Gastos → saldo). Solo los ve y modifica su dueño.
    match /ingresos/{ingresoId} {
      function validIngreso(data) {
        return data.userId == request.auth.uid
          && data.amount is number && data.amount > 0
          && data.date is string && data.date.size() == 10;
      }
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validIngreso(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && validIngreso(incoming());
    }

    match /expenseCategories/{categoryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}